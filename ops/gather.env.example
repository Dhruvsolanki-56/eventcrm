# Install as /etc/gather/gather.env with owner root:gather and mode 0640.
DATABASE_PATH=/var/lib/gather/database/gather.sqlite
UPLOADS_PATH=/var/lib/gather/uploads
SCAN_STORAGE_WORKSPACE_LIMIT_BYTES=536870912
SCAN_STORAGE_TOTAL_LIMIT_BYTES=5368709120
QR_SCAN_WORKSPACE_LIMIT_COUNT=20000
QR_SCAN_TOTAL_LIMIT_COUNT=100000
VOICE_STORAGE_WORKSPACE_LIMIT_BYTES=268435456
VOICE_STORAGE_TOTAL_LIMIT_BYTES=5368709120
VOICE_NOTE_COUNT_WORKSPACE_LIMIT=25000
VOICE_NOTE_COUNT_TOTAL_LIMIT=100000
VOICE_TRANSCRIPT_WORKSPACE_LIMIT_BYTES=16777216
VOICE_TRANSCRIPT_TOTAL_LIMIT_BYTES=536870912
NOTE_STORAGE_WORKSPACE_LIMIT_BYTES=16777216
NOTE_STORAGE_TOTAL_LIMIT_BYTES=536870912
NOTE_COUNT_WORKSPACE_LIMIT=100000
NOTE_COUNT_TOTAL_LIMIT=500000
# Durable caps for follow-up and meeting rows, including closed records.
TASK_COUNT_WORKSPACE_LIMIT=25000
TASK_COUNT_TOTAL_LIMIT=100000
BACKUPS_PATH=/var/lib/gather/backups
PUBLIC_BASE_URL=https://gather.example.com
AI_MODE=off
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=
TRUST_PROXY_HOPS=1
