NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/gather-clean.sqlite
UPLOADS_PATH=uploads-clean
SCAN_STORAGE_WORKSPACE_LIMIT_BYTES=536870912
SCAN_STORAGE_TOTAL_LIMIT_BYTES=5368709120
QR_SCAN_WORKSPACE_LIMIT_COUNT=20000
QR_SCAN_TOTAL_LIMIT_COUNT=100000
VOICE_STORAGE_WORKSPACE_LIMIT_BYTES=268435456
VOICE_STORAGE_TOTAL_LIMIT_BYTES=5368709120
VOICE_NOTE_COUNT_WORKSPACE_LIMIT=25000
VOICE_NOTE_COUNT_TOTAL_LIMIT=100000
VOICE_TRANSCRIPT_WORKSPACE_LIMIT_BYTES=16777216
VOICE_TRANSCRIPT_TOTAL_LIMIT_BYTES=536870912
NOTE_STORAGE_WORKSPACE_LIMIT_BYTES=16777216
NOTE_STORAGE_TOTAL_LIMIT_BYTES=536870912
NOTE_COUNT_WORKSPACE_LIMIT=100000
NOTE_COUNT_TOTAL_LIMIT=500000
# Durable caps for follow-up and meeting rows, including closed records.
TASK_COUNT_WORKSPACE_LIMIT=25000
TASK_COUNT_TOTAL_LIMIT=100000
BACKUPS_PATH=backups-clean
DEMO_PASSWORD=Gather-Demo-2026!
# Development sample sender and test recipient shown in Settings. Never a mail credential.
DEMO_EMAIL_ADDRESS=dhruvtube11@gmail.com
AI_MODE=off
# For photo extraction without a credit card, set AI_MODE=provider, AI_PROVIDER=gemini,
# and a Gemini API key. Free-tier requests are rate limited and Google may use
# submitted photos to improve its products. The key stays on the backend.
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMAIL_MODEL=gemini-3.1-flash-lite
# Optional second writer for email drafts (free key from console.groq.com). Tried first; Gemini is the backup.
GROQ_API_KEY=
GROQ_EMAIL_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=
# Optional HTTPS provider for explicitly approved lead emails and setup tests.
# Leave unset to keep cloud sending off. A verified sender domain is required by the provider.
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
# To use Gmail SMTP for a private local demo, set SMTP_HOST=smtp.gmail.com,
# SMTP_USER, and SMTP_PASSWORD in your untracked .env. A From address alone cannot send mail.
TRUST_PROXY_HOPS=1

# Limits and timeouts (the values shown are the production defaults)
# API_LIMIT_PER_ADDRESS_PER_MINUTE=1500
# API_LIMIT_PER_SESSION_PER_MINUTE=600
# API_REQUEST_TIMEOUT_MS=60000
# REQUEST_TIMEOUT_MS=120000
# KEEP_ALIVE_TIMEOUT_MS=65000
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=20000
# RATE_LIMIT_STORE=database   # shared counters; memory is the default without DATABASE_URL

# Email timing and group email
# AUTO_SEND_MIN_DELAY_SECONDS=300
# CAMPAIGN_DAILY_LIMIT=500

# AI daily limits per workspace, by kind of call (card_read, email_draft, email_draft_alternate, conversation_context,
# transcript_summary, follow_up, business_profile, company_about)
# AI_DAILY_LIMIT_EMAIL_DRAFT=600
PUBLIC_BASE_URL=http://localhost:5173
