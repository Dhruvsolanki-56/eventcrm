{
  "name": "gather-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "seed": "tsx server/seed.ts",
    "seed:e2e": "tsx server/seed-e2e.ts",
    "generate:demo-media": "node scripts/generate-demo-media.mjs",
    "generate:ocr-benchmark": "python scripts/generate_ocr_benchmark.py",
    "benchmark:ocr": "tsx scripts/benchmark-card-ocr.ts",
    "benchmark:ocr:fallbacks": "tsx scripts/evaluate-ocr-fallbacks.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:mail": "node scripts/run-e2e.mjs --smtp-capture tests/e2e/mail.spec.ts tests/e2e/email-rate-limit.spec.ts",
    "test:manual-reading": "node scripts/run-e2e.mjs --manual-reading tests/e2e/manual-reading.spec.ts tests/e2e/read-failure.spec.ts",
    "test:scan-quota": "node scripts/run-e2e.mjs --scan-quota tests/e2e/scan-quota.spec.ts",
    "test:note-quota": "node scripts/run-e2e.mjs --note-quota tests/e2e/note-quota.spec.ts",
    "test:note-count-quota": "node scripts/run-e2e.mjs --note-count-quota tests/e2e/note-count-quota.spec.ts",
    "test:qr-quota": "node scripts/run-e2e.mjs --qr-quota tests/e2e/qr-scan-quota.spec.ts",
    "test:task-quota": "node scripts/run-e2e.mjs --task-quota tests/e2e/task-quota.spec.ts",
    "test:task-rate": "node scripts/run-e2e.mjs --task-rate tests/e2e/task-rate-limit.spec.ts",
    "test:voice-quota": "node scripts/run-e2e.mjs --voice-quota tests/e2e/voice-quota.spec.ts",
    "audit": "node scripts/run-e2e.mjs tests/e2e/audit.spec.ts",
    "audit:accessibility": "node scripts/run-e2e.mjs tests/e2e/accessibility.spec.ts",
    "audit:controls": "node scripts/run-e2e.mjs --full-control-crawl tests/e2e/control-crawl.spec.ts",
    "audit:controls:phone": "node scripts/run-e2e.mjs --full-control-crawl --phone-only tests/e2e/control-crawl.spec.ts",
    "backup": "tsx server/backup.ts",
    "backup:offsite": "node scripts/backup-offsite.mjs",
    "restore": "node scripts/restore-backup.mjs",
    "test:ops": "vitest run tests/backup-offsite.test.mjs",
    "build": "tsc --noEmit && vite build && node scripts/write-precache.mjs && tsc -p tsconfig.server.json && node scripts/copy-runtime-assets.mjs",
    "test:production-smoke": "npm run build && node scripts/smoke-production.mjs",
    "test:public-demo-smoke": "npm run build && node scripts/smoke-public-demo.mjs",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.48.0",
    "nodemailer": "10.0.12",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "tesseract.js": "6.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
